#include sourcemod
#pragma tabsize 0
ConVar EklentiAktif = null; public Plugin myinfo = { name = "Kelime düzenleyici", description = "Kelimeleri düzenler", author = "phiso", version = "", url = "" }; public void OnPluginStart() { EklentiAktif = CreateConVar("sm_kelimeduzeltici_aktif", "1", "Eklenti aktif olsun mu?", 0, true, 0.0, true, 1.0); AutoExecConfig(true, "Kelime_Duzeltici"); } public Action OnClientSayCommand(int client, const char[] command, const char[] sArgs) { if (EklentiAktif.BoolValue) { if (StrEqual(sArgs, "sa", true) || StrEqual(sArgs, "SA", true) || StrEqual(sArgs, "Sa", true) || StrEqual(sArgs, "selamunaleykum", true) || StrEqual(sArgs, "selamun aleykum", true) || StrEqual(sArgs, "sA", true) || StrEqual(sArgs, "s.a", true) || StrEqual(sArgs, "S.A", true) || StrEqual(sArgs, "s.A", true) || StrEqual(sArgs, "S.a", true) || StrEqual(sArgs, "selam", true)) { FakeClientCommand(client, "say Selamun Aleyküm."); return Plugin_Handled; } if (StrEqual(sArgs, "as", true) || StrEqual(sArgs, "AS", true) || StrEqual(sArgs, "a.s", true) || StrEqual(sArgs, "A.S", true) || StrEqual(sArgs, "aleykum selam", true) || StrEqual(sArgs, "aleykumselam", true)) { FakeClientCommand(client, "say Aleyküm Selam."); return Plugin_Handled; } } return Plugin_Continue; } 